#!/bin/sh
set -eu

if ! command -v codex >/dev/null 2>&1; then
  echo "codex is not installed or is not on PATH" >&2
  exit 127
fi

# Scope the compatibility model to this Codex process. GPT-5.6 is currently
# code-mode-only, and Codex CLI 0.149.1 does not deliver hooks for its nested
# apply_patch calls. GPT-5.5 exposes direct, hook-compatible tools.
exec codex -m gpt-5.5 "$@"
